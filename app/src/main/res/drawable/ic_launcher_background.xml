<?xml version="1.0" encoding="utf-8"?>
<!-- The source artwork's own vertical gradient, so the masked edges show no seam. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/ic_launcher_gradient_start"
        android:endColor="@color/ic_launcher_gradient_end"
        android:type="linear" />
</shape>
